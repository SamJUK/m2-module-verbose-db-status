{
    "name": "samjuk/m2-module-verbose-db-status",
    "description": "Adds a verbose mode to the setup:db:status command, to assist with debugging DB schema differences",
    "type": "magento2-module",
    "license": [
        "MIT"
    ],
    "authors": [
        {
            "name": "Sam James",
            "email": "sam@samdjames.uk"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "php": ">=7.3",
        "magento/framework": "^103.0",
        "ext-json": "*"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "SamJUK\\VerboseDBStatus\\": ""
        }
    },
    "homepage": "https://github.com/SamJUK/m2-module-verbose-db-status",
    "keywords": [
        "magento2",
        "magento 2",
        "magento2-module",
        "adobe-commerce",
        "extension",
        "cli",
        "command-line",
        "setup-db-status",
        "database",
        "schema",
        "debugging",
        "devtools",
        "open-source"
    ],
    "require-dev": {
        "samjuk/dev-standards": "^1.0",
        "magento/magento-coding-standard": "^41",
        "phpunit/phpunit": "^9.5 || ^10.5 || ^12.5",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1"
    },
    "repositories": [{
        "name": "mage-os",
        "type": "composer",
        "url": "https://mirror.mage-os.org/"
    }],
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "magento/composer-dependency-version-audit-plugin": false,
            "magento/magento-composer-installer": false,
            "phpstan/extension-installer": true
        }
    }
}
